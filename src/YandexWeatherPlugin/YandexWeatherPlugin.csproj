<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!--Public-->
        <PackageId>mdimai666.YandexWeatherPlugin</PackageId>
        <Version>0.2.3</Version>
        <Authors>mdimai666</Authors>
        <Company>mdimai666</Company>
        <Product>YandexWeatherPlugin</Product>
        <PackageTags>Mars;yandex;weather;</PackageTags>
        <Description>
            Gets weather from Yandex services.
        </Description>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/mdimai666/Mars.YandexWeatherPlugin</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>

        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Services\geo-codes.txt" />
    </ItemGroup>

    <ItemGroup>
        <!--this is information for mars-->
        <AssemblyMetadata Include="PackageTags" Value="$(PackageTags)" />
        <AssemblyMetadata Include="PackageId" Value="$(PackageId)" />
        <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
        <AssemblyMetadata Include="PackageIcon" Value="$(PackageIcon)" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Services\geo-codes.txt" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Link="wwwroot\icon.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="mdimai666.Mars.Data" Version="0.8.4-alpha.57" />
        <PackageReference Include="mdimai666.Mars.Data.PostgreSQL" Version="0.8.4-alpha.57" />
        <PackageReference Include="mdimai666.Mars.Plugin.Sdk" Version="0.8.4-alpha.57">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="mdimai666.Mars.Plugin.Kit.Host" Version="0.8.4-alpha.57" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\YandexWeatherPlugin.Front\YandexWeatherPlugin.Front.csproj" />
        <ProjectReference Include="..\YandexWeatherPlugin.Shared\YandexWeatherPlugin.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="appsettings.local.json">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- Паковка — таргетами пакета mdimai666.Mars.Plugin.Sdk (без явных таргетов здесь):
         publish Release -> отсечение сборок Марса + манифест + дескриптор + zip;
         dotnet msbuild -t:MarsPluginPackNuget -c Release -> nupkg;
         Debug-сборка -> дев-манифест. -->

</Project>
